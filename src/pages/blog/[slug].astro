---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Dados estruturados: artigo + trilha de navegação
const site = Astro.site?.href ?? 'https://bolaverso.com';
const urlPost = `${site}blog/${post.slug}/`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.titulo,
    description: post.data.descricao,
    datePublished: post.data.data.toISOString(),
    dateModified: post.data.data.toISOString(),
    inLanguage: "pt-BR",
    author: { "@type": "Organization", name: post.data.autor || "Bolaverso" },
    publisher: { "@type": "Organization", name: "Bolaverso", url: site },
    mainEntityOfPage: { "@type": "WebPage", "@id": urlPost },
    url: urlPost,
    keywords: (post.data.tags || []).join(", "),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: site },
      { "@type": "ListItem", position: 2, name: "Análises", item: `${site}blog/` },
      { "@type": "ListItem", position: 3, name: post.data.titulo, item: urlPost },
    ],
  },
];
---
<Base title={`${post.data.titulo} — Bolaverso`} description={post.data.descricao} schema={schema}>
  <article>
    <header class="post-head">
      <h1>{post.data.titulo}</h1>
      <p class="meta">
        {post.data.data.toLocaleDateString('pt-BR', {
          day: '2-digit', month: 'long', year: 'numeric',
        })} · {post.data.autor}
      </p>
    </header>
    <div class="post-body">
      <Content />
    </div>
    <footer class="post-foot">
      <a href="/blog/">← Voltar para análises</a>
    </footer>
  </article>
</Base>

<style>
  article { max-width: 68ch; margin: 0 auto; }
  .post-head { margin-bottom: 2rem; }
  .post-head h1 { margin-bottom: 0.5rem; }
  .meta { color: var(--cinza); font-size: 0.9rem; }
  .post-body :global(h2) { margin-top: 2rem; }
  .post-body :global(p) { line-height: 1.7; }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--verde);
    padding-left: 1rem; margin-left: 0;
    color: var(--cinza); font-style: italic;
  }
  .post-foot { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--borda); }
</style>
