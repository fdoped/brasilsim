---
// Layout base: header, footer, meta SEO. Todas as páginas herdam daqui.
interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
const site = Astro.site;
const urlAtual = new URL(Astro.url.pathname, site);
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical || urlAtual.href} />

  <!-- Open Graph para redes sociais -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={urlAtual.href} />
  <meta property="og:locale" content="pt_BR" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <style is:global>
    :root {
      --verde: #06AA48;
      --azul: #2a78d6;
      --amarelo: #ffd85d;
      --vermelho: #e34948;
      --fundo: #fafafa;
      --texto: #1a1a1a;
      --cinza: #6b7280;
      --borda: #e5e7eb;
      --card: #ffffff;
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--fundo);
      color: var(--texto);
      line-height: 1.55;
    }
    a { color: var(--azul); text-decoration: none; }
    a:hover { text-decoration: underline; }
    header {
      background: var(--card);
      border-bottom: 1px solid var(--borda);
      padding: 1rem 0;
    }
    .container {
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }
    .nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .logo {
      font-weight: 800;
      font-size: 1.35rem;
      color: var(--verde);
      text-decoration: none;
    }
    .nav ul {
      display: flex;
      gap: 1.5rem;
      list-style: none;
      margin: 0; padding: 0;
    }
    .nav ul a {
      color: var(--texto);
      font-weight: 500;
      font-size: 0.95rem;
    }
    main { padding: 2rem 0 3rem; }
    footer {
      background: var(--card);
      border-top: 1px solid var(--borda);
      padding: 2rem 0;
      color: var(--cinza);
      font-size: 0.9rem;
      margin-top: 3rem;
    }
    footer .container {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
    }
    footer a { color: var(--cinza); }
    h1 { font-size: 2rem; margin: 0 0 0.5rem; }
    h2 { font-size: 1.4rem; margin: 2rem 0 0.75rem; }
	/* Botões flutuantes de compartilhamento */
    .compartilhar {
      position: fixed;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 8px;
      background: var(--card);
      border: 1px solid var(--borda);
      border-right: none;
      border-radius: 10px 0 0 10px;
      box-shadow: -2px 2px 8px rgba(0,0,0,0.08);
      z-index: 50;
    }
    .compartilhar-label {
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--cinza);
      text-align: center;
      margin-bottom: 2px;
    }
    .share-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 8px;
      color: #fff;
      transition: transform 0.12s, opacity 0.12s;
    }
    .share-btn:hover { transform: scale(1.08); opacity: 0.9; text-decoration: none; }
    .share-btn.wpp { background: #25D366; }
    .share-btn.x   { background: #000000; }
    .share-btn.fb  { background: #1877F2; }
	/* Legenda do gráfico (criada por JS, precisa de estilo global) */
    .grafico-legenda {
      display: flex; flex-wrap: wrap; gap: 1rem;
      margin-top: 0.75rem; justify-content: center;
    }
    .leg-item {
      display: inline-flex; align-items: center; gap: 0.35rem;
      font-size: 0.85rem; color: var(--texto);
    }
    .leg-cor { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }

    @media (max-width: 640px) {
      .compartilhar {
        top: auto;
        bottom: 0;
        right: 0;
        left: 0;
        transform: none;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        border-radius: 12px 12px 0 0;
        border: 1px solid var(--borda);
        border-bottom: none;
      }
      .compartilhar-label {
        margin: 0 6px 0 0;
        align-self: center;
      }
    }
  </style>
<!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-90H5KVD89T"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-90H5KVD89T');
  </script>
</head>
<body>
  <header>
    <div class="container nav">
      <a href="/" class="logo">⚽ Bolaverso</a>
      <ul>
        <li><a href="/">Simulador</a></li>
		<li><a href="/comparar/">Comparar</a></li>
        <li><a href="/blog/">Análises</a></li>
        <li><a href="/metodologia/">Metodologia</a></li>
        <li><a href="/sobre/">Sobre</a></li>
      </ul>
    </div>
  </header>
  <main>
    <div class="container">
      <slot />
    </div>
  </main>
  <!-- Botões flutuantes de compartilhamento -->
  <div class="compartilhar">
    <span class="compartilhar-label">Compartilhar</span>
    <a class="share-btn wpp" href={`https://api.whatsapp.com/send?text=${encodeURIComponent('Veja as chances no Brasileirão: ' + urlAtual.href)}`}
       target="_blank" rel="noopener" aria-label="Compartilhar no WhatsApp" title="WhatsApp">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.67c2.2 0 4.26.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.16 8.16 0 0 1-1.26-4.37c0-4.54 3.7-8.24 8.24-8.24zm4.52 10.31c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.22.24-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>
    </a>
    <a class="share-btn x" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent('Veja as chances no Brasileirão')}&url=${encodeURIComponent(urlAtual.href)}`}
       target="_blank" rel="noopener" aria-label="Compartilhar no X" title="X (Twitter)">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
    <a class="share-btn fb" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(urlAtual.href)}`}
       target="_blank" rel="noopener" aria-label="Compartilhar no Facebook" title="Facebook">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.03 4.39 11.03 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8v8.44C19.61 23.1 24 18.1 24 12.07z"/></svg>
    </a>
  </div>
  <footer>
    <div class="container">
      <div>© 2026 Bolaverso · Simulações independentes</div>
      <div>
        <a href="/privacidade/">Privacidade</a> ·
        <a href="/termos/">Termos</a> ·
        <a href="/contato/">Contato</a>
      </div>
    </div>
  </footer>
</body>
</html>
